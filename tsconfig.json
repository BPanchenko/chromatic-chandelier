{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "preserveConstEnums": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "sourceMap": true,
    "target": "ES2022"
  },
  "include": ["__tests__/*", ".config/*", "node_scripts/**/*"]
}
